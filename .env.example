SECRET_KEY_BASE=local_development_secret_key_base_quoteMe

#DB
DB_HOST=database
DB_NAME=Walltaker
DB_PORT=5432
DB_HOST_PORT=127.0.0.1:5432 # prefix 127.0.0.1: means that the database is only accessible from the host machine. (still reachable by proxy)
DB_USER=postgres
DB_PASSWORD=secretPassword

#Rails
RAILS_HOST_PORT=3000
RAILS_ENV=production

#Cache
CACHE_PORT=6379
CACHE_HOST=redis
CACHE_HOST_PORT=127.0.0.1:6379 # prefix 127.0.0.1: means that the redis is only accessible from the host machine. (still reachable by proxy)

#Walltaker
WALLTAKER_HOST=some.Url.net
WALLTAKER_URL=https://some.Url.net

COMMIT_LINK=https://github.com/Lycraon/walltaker/commit/main

#E621_USER=<your username>
#WALLTAKER_MAIL_FROM

#deployment metadata
COMMIT_HASH=
RELEASE_CREATED_AT=

#Bot Job

#Mail